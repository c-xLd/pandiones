{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-isolated",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set PANDIONES_LAN_PREVIEW=1&& npx next dev"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "prod-measure",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set PANDIONES_DIST_DIR=.next-perf&& npx next start"
      ],
      "port": 3005,
      "autoPort": true
    },
    {
      "name": "dev-auto",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set PANDIONES_DIST_DIR=.next-claude&& npx next dev"
      ],
      "port": 3002,
      "autoPort": true
    },
    {
      "name": "dev-localdb",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/pandiones_dev&& set DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54329/pandiones_dev&& set PANDIONES_DIST_DIR=.next-localdb&& npx next dev -p 3007"
      ],
      "port": 3007
    }
  ]
}
